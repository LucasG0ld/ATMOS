{
  "name": "atmos",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "An immersive visual and sound atmosphere experience.",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "smoke:local": "npm run build && node scripts/smoke-local.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "rollback:check": "node scripts/validate-rollback.mjs",
    "audio:prepare": "node scripts/prepare-audio.mjs && node scripts/validate-audio.mjs",
    "audio:check": "node scripts/validate-audio.mjs",
    "images:check": "node scripts/validate-image-assets.mjs",
    "budget:check": "node scripts/validate-build-budgets.mjs",
    "performance:lighthouse": "node scripts/measure-lighthouse.mjs",
    "performance:runtime": "node scripts/measure-runtime.mjs",
    "performance:composer": "node scripts/measure-composer-runtime.mjs",
    "audit:prod": "npm audit --omit=dev",
    "visual:capture": "npm run build && node scripts/capture-visual-references.mjs",
    "design:audit:capture": "npm run build && node scripts/audit-design-capture.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "lucide-react": "1.31.0",
    "motion": "13.0.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "ffmpeg-static": "5.3.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
